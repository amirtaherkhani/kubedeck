# Project-local Infisical credential backend (default: env).
# Keep the real .env private (mode 0600) and out of Git.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
# Optional host HTTPS bridge bearer, 32-256 characters. Store the real value
# only in the private .env and the matching Kubernetes Secret, never Helm values.
KUCHDESK_HOST_BRIDGE_TOKEN=

# Base project DISPLAY metadata: export in the agent process environment.
# The credential loader does not source these lines automatically.
# KUCHDESK_BASE_PROJECT_NAME=Kubedesk Platform
# KUCHDESK_BASE_PROJECT_ID=<immutable-project-id>
# KUCHDESK_BASE_PROJECT_SLUG=<explicit-base-project-slug>
