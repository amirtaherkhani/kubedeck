# Local development only. Kubernetes releases load these values from the
# Infisical-managed Secret home-lab/local:/apps/development-tools/kubedeck.
# Leave all four values unset to use the "Create the admin account" page.
KUBEDECK_ADMIN_FIRST_NAME=
KUBEDECK_ADMIN_LAST_NAME=
KUBEDECK_ADMIN_EMAIL=
KUBEDECK_ADMIN_PASSWORD=

# Local development only. Kubernetes uses the Infisical-managed agent Secret
# at home-lab/local:/apps/development-tools/kubedeck-agent.
KUBEDECK_AGENT_URL=http://kubedeck-agent:8080
KUBEDECK_AGENT_TOKEN=
