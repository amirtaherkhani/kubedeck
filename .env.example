# Project-local Infisical credential backend (default: env).
# Keep the real .env private (mode 0600) and out of Git.
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
# Optional host HTTPS bridge bearer, 32-256 characters. Store the real value
# only in the private .env and the matching Kubernetes Secret, never Helm values.
KUCHDESK_HOST_BRIDGE_TOKEN=

# Base project display metadata: process environment > this file > defaults.
# Literal values; do not shell-source this file. Metadata reloads on CLI calls
# and MCP capability requests; process environment changes require restart.
# These labels never authorize project access.
KUCHDESK_BASE_PROJECT_NAME=Kubedesk Platform
KUCHDESK_BASE_PROJECT_ID=
KUCHDESK_BASE_PROJECT_SLUG=
