{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kubedeck.io/schemas/service-module/v1alpha1/schema.json",
  "title": "KubeDeck ServiceModule v1alpha1",
  "description": "Portable declarative metadata for a managed or externally observed service module.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "module", "components"],
  "properties": {
    "apiVersion": { "const": "catalog.kubedeck.io/v1alpha1" },
    "kind": { "const": "ServiceModule" },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "category", "ownership", "purpose"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "minLength": 1, "maxLength": 64 },
        "ownership": { "enum": ["managed", "external"] },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
        "documentation": { "type": "string", "format": "uri-reference" },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/component" }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "reference": { "type": "string", "minLength": 1, "maxLength": 255 },
    "workloadRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "kind", "name", "namespace"],
      "properties": {
        "apiVersion": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "labelSelector": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "protocol", "addressRef"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "protocol": { "enum": ["http", "https", "tcp", "grpc", "amqp", "other"] },
        "addressRef": { "$ref": "#/definitions/reference" },
        "portName": { "type": "string", "minLength": 1 }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "purpose"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "enum": ["database", "broker", "microservice", "web-app", "worker", "infrastructure", "open-source-tool", "other"] },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
        "provides": { "type": "array", "items": { "$ref": "#/definitions/reference" }, "uniqueItems": true },
        "requires": { "type": "array", "items": { "$ref": "#/definitions/reference" }, "uniqueItems": true },
        "externalConnections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "targetRef"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "targetRef": { "$ref": "#/definitions/reference" },
              "protocol": { "type": "string", "minLength": 1 }
            }
          }
        },
        "workloadRefs": { "type": "array", "items": { "$ref": "#/definitions/workloadRef" } },
        "endpoints": { "type": "array", "items": { "$ref": "#/definitions/endpoint" } },
        "healthChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type", "targetRef"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "type": { "enum": ["kubernetes-readiness", "kubernetes-liveness", "http", "tcp"] },
              "targetRef": { "$ref": "#/definitions/reference" },
              "path": { "type": "string", "pattern": "^/" },
              "expectedStatus": { "type": "integer", "minimum": 100, "maximum": 599 }
            }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dashboards": { "type": "array", "items": { "$ref": "#/definitions/reference" } },
            "metrics": { "type": "array", "items": { "$ref": "#/definitions/reference" } },
            "logs": { "type": "array", "items": { "$ref": "#/definitions/reference" } }
          }
        },
        "secretRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "projectRef", "environmentRef", "path"],
            "properties": {
              "provider": { "const": "infisical" },
              "projectRef": { "$ref": "#/definitions/reference" },
              "environmentRef": { "$ref": "#/definitions/reference" },
              "path": { "type": "string", "pattern": "^/" },
              "secretName": { "type": "string", "minLength": 1 },
              "keys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
            }
          }
        }
      }
    }
  }
}
