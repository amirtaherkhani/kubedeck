{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kubedeck.io/schemas/installation-profile/v1alpha1/schema.json",
  "title": "KubeDeck InstallationProfile v1alpha1",
  "description": "Environment-specific managed module installation state, separate from service identity and observation metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "profile", "installations"],
  "properties": {
    "apiVersion": { "const": "catalog.kubedeck.io/v1alpha1" },
    "kind": { "const": "InstallationProfile" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "target"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "target": { "enum": ["local-single-node"] }
      }
    },
    "installations": {
      "type": "array",
      "items": { "$ref": "#/definitions/installation" }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleId", "releaseName", "namespace", "chart"],
      "properties": {
        "moduleId": { "$ref": "#/definitions/id" },
        "releaseName": { "$ref": "#/definitions/id" },
        "namespace": { "$ref": "#/definitions/id" },
        "chart": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "name", "version"],
          "properties": {
            "source": { "type": "string", "minLength": 1, "maxLength": 255 },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 64 },
            "localPath": { "$ref": "#/definitions/relativePath" }
          }
        },
        "valuesFiles": {
          "type": "array",
          "items": { "$ref": "#/definitions/relativePath" },
          "uniqueItems": true
        }
      }
    }
  }
}
