{
  "uid": "rabbitmq-overview",
  "title": "RabbitMQ Overview",
  "description": "Platform RabbitMQ health, queue depth, throughput, and resource headroom. Queue metrics are filtered to the selected namespace and pod.",
  "schemaVersion": 41,
  "version": 1,
  "tags": ["rabbitmq", "platform", "prometheus"],
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "RabbitMQ management UI",
      "type": "link",
      "url": "https://rabbitmq-ui.local.dev",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(rabbitmq_queues, namespace)",
        "query": { "query": "label_values(rabbitmq_queues, namespace)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": { "text": "platform-storage", "value": "platform-storage" }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(rabbitmq_queues{namespace=\"$namespace\"}, pod)",
        "query": { "query": "label_values(rabbitmq_queues{namespace=\"$namespace\"}, pod)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "vhost",
        "label": "Finance vhost",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(rabbitmq_detailed_queue_messages{namespace=\"$namespace\"}, vhost)",
        "query": { "query": "label_values(rabbitmq_detailed_queue_messages{namespace=\"$namespace\"}, vhost)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": { "text": "/vero-vault-finance", "value": "/vero-vault-finance" }
      },
      {
        "name": "queue",
        "label": "Finance queue",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(rabbitmq_detailed_queue_messages{namespace=\"$namespace\",vhost=\"$vhost\"}, queue)",
        "query": { "query": "label_values(rabbitmq_detailed_queue_messages{namespace=\"$namespace\",vhost=\"$vhost\"}, queue)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scrape health",
      "description": "RabbitMQ Prometheus endpoint health. This should be 1 for every selected broker pod.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 5 },
      "targets": [{ "expr": "min(up{job=\"rabbitmq\",namespace=\"$namespace\",pod=~\"$pod\"})", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "none", "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Connections",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 5 },
      "targets": [{ "expr": "sum(rabbitmq_connections{namespace=\"$namespace\",pod=~\"$pod\"})", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 100 }] } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Queues",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 5 },
      "targets": [{ "expr": "sum(rabbitmq_queues{namespace=\"$namespace\",pod=~\"$pod\"})", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 100 }] } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Messages ready",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 5 },
      "targets": [{ "expr": "sum(rabbitmq_queue_messages_ready{namespace=\"$namespace\",pod=~\"$pod\"})", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1000 }, { "color": "red", "value": 10000 }] } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Messages unacknowledged",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 5 },
      "targets": [{ "expr": "sum(rabbitmq_queue_messages_unacked{namespace=\"$namespace\",pod=~\"$pod\"})", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" },
      "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 500 }, { "color": "red", "value": 5000 }] } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Memory use",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 5 },
      "targets": [{ "expr": "100 * sum(rabbitmq_process_resident_memory_bytes{namespace=\"$namespace\",pod=~\"$pod\"}) / sum(rabbitmq_resident_memory_limit_bytes{namespace=\"$namespace\",pod=~\"$pod\"})", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }, "showThresholdLabels": false, "showThresholdMarkers": true, "orientation": "auto" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 }] } }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rabbitmq_queue_messages_ready{namespace=\"$namespace\",pod=~\"$pod\"})", "legendFormat": "Ready", "refId": "A" },
        { "expr": "sum(rabbitmq_queue_messages_unacked{namespace=\"$namespace\",pod=~\"$pod\"})", "legendFormat": "Unacked", "refId": "B" },
        { "expr": "sum(rabbitmq_queue_messages{namespace=\"$namespace\",pod=~\"$pod\"})", "legendFormat": "Total", "refId": "C" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false } }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Message throughput",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(rabbitmq_global_messages_received_total{namespace=\"$namespace\",pod=~\"$pod\"}[5m]))", "legendFormat": "Received", "refId": "A" },
        { "expr": "sum(rate(rabbitmq_global_messages_delivered_total{namespace=\"$namespace\",pod=~\"$pod\"}[5m]))", "legendFormat": "Delivered", "refId": "B" },
        { "expr": "sum(rate(rabbitmq_global_messages_acknowledged_total{namespace=\"$namespace\",pod=~\"$pod\"}[5m]))", "legendFormat": "Acknowledged", "refId": "C" },
        { "expr": "sum(rate(rabbitmq_global_messages_redelivered_total{namespace=\"$namespace\",pod=~\"$pod\"}[5m]))", "legendFormat": "Redelivered", "refId": "D" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false } }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Broker resources",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rabbitmq_process_resident_memory_bytes{namespace=\"$namespace\",pod=~\"$pod\"})", "legendFormat": "Resident memory", "refId": "A" },
        { "expr": "sum(rabbitmq_disk_space_available_bytes{namespace=\"$namespace\",pod=~\"$pod\"})", "legendFormat": "Available disk", "refId": "B" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false } }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Finance queues",
      "description": "Per-queue Finance backlog and consumer count from the bounded detailed RabbitMQ scrape.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rabbitmq_detailed_queue_messages{namespace=\"$namespace\",pod=~\"$pod\",vhost=\"$vhost\",queue=~\"$queue\"}", "format": "table", "instant": true, "refId": "A" },
        { "expr": "rabbitmq_detailed_queue_consumers{namespace=\"$namespace\",pod=~\"$pod\",vhost=\"$vhost\",queue=~\"$queue\"}", "format": "table", "instant": true, "refId": "B" }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true, "instance": true, "job": true, "endpoint": true, "service": true, "container": true }, "indexByName": {}, "renameByName": { "Value #A": "Messages", "Value #B": "Consumers", "queue": "Queue", "vhost": "Vhost" } } }]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Finance queue backlog",
      "description": "Ready, unacknowledged, and total messages for every selected Finance queue.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (queue) (rabbitmq_detailed_queue_messages_ready{namespace=\"$namespace\",pod=~\"$pod\",vhost=\"$vhost\",queue=~\"$queue\"})", "legendFormat": "{{queue}} ready", "refId": "A" },
        { "expr": "sum by (queue) (rabbitmq_detailed_queue_messages_unacked{namespace=\"$namespace\",pod=~\"$pod\",vhost=\"$vhost\",queue=~\"$queue\"})", "legendFormat": "{{queue}} unacked", "refId": "B" },
        { "expr": "sum by (queue) (rabbitmq_detailed_queue_messages{namespace=\"$namespace\",pod=~\"$pod\",vhost=\"$vhost\",queue=~\"$queue\"})", "legendFormat": "{{queue}} total", "refId": "C" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false } }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Finance consumers and capacity",
      "description": "Zero consumers with a growing backlog requires investigation. Capacity below one indicates constrained consumption.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (queue) (rabbitmq_detailed_queue_consumers{namespace=\"$namespace\",pod=~\"$pod\",vhost=\"$vhost\",queue=~\"$queue\"})", "legendFormat": "{{queue}} consumers", "refId": "A" },
        { "expr": "avg by (queue) (rabbitmq_detailed_queue_consumer_capacity{namespace=\"$namespace\",pod=~\"$pod\",vhost=\"$vhost\",queue=~\"$queue\"})", "legendFormat": "{{queue}} capacity", "refId": "B" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false } }, "overrides": [] }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Oldest Finance queue message",
      "description": "Age of the head message for non-empty queues. This is a direct backlog-age signal, not a request latency metric.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 29, "w": 8, "h": 8 },
      "targets": [{ "expr": "time() - rabbitmq_detailed_queue_head_message_timestamp{namespace=\"$namespace\",pod=~\"$pod\",vhost=\"$vhost\",queue=~\"$queue\"}", "legendFormat": "{{queue}}", "refId": "A" }],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 60 }, { "color": "red", "value": 300 }] } }, "overrides": [] }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Finance queue storage and disk I/O",
      "description": "Per-queue queue-process memory and disk I/O. Use broker-wide message throughput above for delivery, acknowledgement, and redelivery rates.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 29, "w": 16, "h": 8 },
      "targets": [
        { "expr": "sum by (queue) (rabbitmq_detailed_queue_process_memory_bytes{namespace=\"$namespace\",pod=~\"$pod\",vhost=\"$vhost\",queue=~\"$queue\"})", "legendFormat": "{{queue}} process memory", "refId": "A" },
        { "expr": "sum by (queue) (rate(rabbitmq_detailed_queue_disk_reads_total{namespace=\"$namespace\",pod=~\"$pod\",vhost=\"$vhost\",queue=~\"$queue\"}[5m]))", "legendFormat": "{{queue}} disk reads/s", "refId": "B" },
        { "expr": "sum by (queue) (rate(rabbitmq_detailed_queue_disk_writes_total{namespace=\"$namespace\",pod=~\"$pod\",vhost=\"$vhost\",queue=~\"$queue\"}[5m]))", "legendFormat": "{{queue}} disk writes/s", "refId": "C" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false } }, "overrides": [] }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Broker connection and authentication churn",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 37, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(rabbitmq_connections_opened_total{namespace=\"$namespace\",pod=~\"$pod\"}[5m]))", "legendFormat": "Connections opened", "refId": "A" },
        { "expr": "sum(rate(rabbitmq_connections_closed_total{namespace=\"$namespace\",pod=~\"$pod\"}[5m]))", "legendFormat": "Connections closed", "refId": "B" },
        { "expr": "sum(rate(rabbitmq_auth_attempts_failed_total{namespace=\"$namespace\",pod=~\"$pod\"}[5m]))", "legendFormat": "Authentication failures", "refId": "C" },
        { "expr": "sum(rate(rabbitmq_channels_closed_total{namespace=\"$namespace\",pod=~\"$pod\"}[5m]))", "legendFormat": "Channels closed", "refId": "D" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "spanNulls": false } }, "overrides": [] }
    },
    {
      "id": 16,
      "type": "table",
      "title": "Broker safeguards",
      "description": "All watermark alarms and unreachable peers should remain zero. This local cluster has one broker, so this is not HA evidence.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 37, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rabbitmq_alarms_memory_used_watermark{namespace=\"$namespace\",pod=~\"$pod\"}", "format": "table", "instant": true, "refId": "A" },
        { "expr": "rabbitmq_alarms_free_disk_space_watermark{namespace=\"$namespace\",pod=~\"$pod\"}", "format": "table", "instant": true, "refId": "B" },
        { "expr": "rabbitmq_alarms_file_descriptor_limit{namespace=\"$namespace\",pod=~\"$pod\"}", "format": "table", "instant": true, "refId": "C" },
        { "expr": "rabbitmq_unreachable_cluster_peers_count{namespace=\"$namespace\",pod=~\"$pod\"}", "format": "table", "instant": true, "refId": "D" }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Finance virtual host health",
      "description": "The Finance virtual host must be running before its queues and exchanges can accept work.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 45, "w": 6, "h": 6 },
      "targets": [
        { "expr": "min(rabbitmq_cluster_vhost_status{namespace=\"$namespace\",vhost=\"$vhost\"})", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "mappings": [{ "options": { "0": { "text": "Down" }, "1": { "text": "Up" } }, "type": "value" }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 18,
      "type": "table",
      "title": "Finance exchanges and bindings",
      "description": "Lists exchange bindings in the Finance virtual host. A missing expected exchange or binding is a topology issue.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 45, "w": 18, "h": 6 },
      "targets": [
        { "expr": "rabbitmq_cluster_exchange_bindings{namespace=\"$namespace\",vhost=\"$vhost\"}", "format": "table", "instant": true, "refId": "A" }
      ],
      "options": { "showHeader": true, "cellHeight": "sm" },
      "fieldConfig": { "defaults": { "decimals": 0 }, "overrides": [] }
    }
  ]
}
