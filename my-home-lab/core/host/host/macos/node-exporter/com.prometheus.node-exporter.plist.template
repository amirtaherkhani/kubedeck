<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.prometheus.node-exporter</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/node_exporter</string>
    <string>--web.listen-address=0.0.0.0:__PORT__</string>
    <string>--no-collector.thermal</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/node-exporter.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/node-exporter.err.log</string>
</dict>
</plist>
